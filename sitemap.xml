---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.pages %}
  {% if page.lang == site.default_lang and page.sitemap != false %}
    {% for lang in site.languages %}
  <url>
    <loc>{{ site.url | xml_escape }}{{ site.baseurl | xml_escape }}{% unless lang == site.default_lang %}/{{ lang }}{% endunless %}{{ page.url | xml_escape }}</loc>
  </url>
    {% endfor %}
  {% endif %}
{% endfor %}
</urlset>
